#!/bin/sh

if command -v pwsh >/dev/null 2>&1; then
  POWERSHELL=pwsh
elif command -v powershell >/dev/null 2>&1; then
  POWERSHELL=powershell
else
  echo "PowerShell is required for the AI Wiki verification gate." >&2
  exit 1
fi

$POWERSHELL -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1 || exit $?
